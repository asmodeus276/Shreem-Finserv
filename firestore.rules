rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Secure lead collection:
    // - Allow creating a new lead only if DPDP consent is explicitly granted (true) and mobile number is provided
    // - Allow individual document lookup by Application Reference ID (get only, no listing)
    // - Strictly forbid updating, deleting, or listing entire database
    match /leads/{leadId} {
      allow create: if request.resource.data.consent == true && request.resource.data.mobile is string;
      allow get: if true;
      allow list, update, delete: if false;
    }

    // Secure channel partners collection (DSA / CA / Consultants)
    match /partners/{partnerId} {
      allow create: if request.resource.data.mobile is string;
      allow get, list, update, delete: if false;
    }

    // Secure careers / job applications collection
    match /careers/{careerId} {
      allow create: if request.resource.data.phone is string;
      allow get, list, update, delete: if false;
    }
    
    // Explicitly deny all client-side read and write operations on rate limits
    // Rate limits are managed server-side by backend security and App Check layers
    match /rate_limits/{docId} {
      allow read, write: if false;
    }
    
    // Application tracking public lookup view (read-only by application ID if exposed via collection)
    // Direct client writes are forbidden
    match /application_status/{appId} {
      allow read: if false; // All tracking handled via secure cloud function 'trackApplication'
      allow write: if false;
    }

    // Default lockdown for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
